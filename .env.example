# Reference only. The Python runtime reads the process environment,
# not this file. Set actual credentials securely outside source control.
OSA_REPO=/absolute/path/to/repository
OSA_BASE_URL=https://api.deepseek.com
OSA_MODEL=deepseek-flash
OSA_API_KEY=

# Optional GitHub source. Polling is read-only; candidates remain observed.
OSA_GITHUB_REPO=owner/repository
OSA_ALLOWED_ACTORS=your-github-login
OSA_BOT_MENTION=opensuperagent
OSA_GITHUB_POLL=0
OSA_GITHUB_TOKEN=
OSA_CANDIDATE_LABEL=agent-candidate

# Optional webhook intake. Configure a separate HTTPS ingress for this route.
OSA_WEBHOOK_SECRET=
