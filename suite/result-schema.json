{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenSuperAgent normalized result rows",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "track", "benchmark", "protocol", "agent", "task_id", "repository", "seed",
      "protocol_valid", "accounting_valid", "scoring_valid", "success",
      "actual_api_tokens", "completion_s"
    ],
    "properties": {
      "track": {"type": "string"},
      "benchmark": {"type": "string"},
      "protocol": {"type": ["string", "null"]},
      "agent": {"type": "string"},
      "task_id": {"type": "string"},
      "repository": {"type": "string"},
      "seed": {"type": "integer"},
      "protocol_valid": {"type": "boolean"},
      "accounting_valid": {"type": "boolean"},
      "scoring_valid": {"type": "boolean"},
      "success": {"type": ["boolean", "null"]},
      "actual_api_tokens": {"type": ["integer", "null"], "minimum": 0},
      "observed_api_tokens": {"type": "integer", "minimum": 0},
      "total_token_upper_bound": {"type": "integer", "minimum": 0},
      "completion_s": {"type": ["number", "null"], "minimum": 0},
      "batch_id": {"type": "string"},
      "batch_wall_s": {"type": "number", "minimum": 0},
      "batch_task_count": {"type": "integer", "minimum": 1},
      "failure_class": {"enum": [null, "infrastructure", "scoring", "protocol", "accounting"]}
    }
  }
}
